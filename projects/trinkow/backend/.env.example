# Mongo bağlantısı — yerelde çalışan MongoDB (Compass ile incelenir)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=trinkow

# JWT gizli anahtarı — GERÇEK DEĞERİ ASLA COMMIT ETME
JWT_SECRET_KEY=degistir-bu-cok-gizli-ve-rastgele-bir-anahtar-olmali
JWT_ALGORITHM=HS256

# Token ömürleri
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Yalnız yerel test girişi. dev.py bunu yerel MongoDB ile açar.
TRINKOW_DEV_LOGIN=0

# Parola sıfırlama postası — yerel geliştirmede dosya tabanlı posta kutusu
MAIL_MODE=outbox
MAIL_OUTBOX_DIR=/tmp/trinkow-mail-outbox
PASSWORD_RESET_URL=trinkow://sifre-sifirla

# Canlı SMTP kullanımı için MAIL_MODE=smtp yapıp aşağıdakileri doldur.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_FROM=noreply@example.com
# SMTP_USER=
# SMTP_PASSWORD=
